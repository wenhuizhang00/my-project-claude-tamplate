# Copy to scripts/agent-runtime/config.env (gitignored) and tune.
# AGENT_WATCH_PORTS: comma-separated TCP ports often used by agent control planes / CDP.
AGENT_WATCH_PORTS="8443,9222,18789,3000,7681"
# If 1, listening on 0.0.0.0 / * on a watched port is a failure (strict CI).
STRICT_LISTENERS=0
# If 1, `npm audit` high/critical becomes non-zero (requires package-lock.json).
STRICT_NPM_AUDIT=0
# If 1, failure when gitleaks binary is missing (use in CI after installing gitleaks).
STRICT_GITLEAKS=0
